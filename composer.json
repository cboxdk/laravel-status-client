{
    "name": "cboxdk/laravel-status-client",
    "description": "Cbox Status for Laravel: read a status page's public JSON with origin fallback, freshness and signed emergency notices, and show incident and maintenance banners in any app.",
    "keywords": [
        "cbox",
        "status",
        "status-page",
        "incidents",
        "maintenance",
        "laravel"
    ],
    "homepage": "https://github.com/cboxdk/laravel-status-client",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cboxdk/laravel-status-client/issues",
        "source": "https://github.com/cboxdk/laravel-status-client"
    },
    "authors": [
        {
            "name": "Sylvester Damgaard",
            "email": "sn@cbox.dk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-sodium": "*",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\StatusClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\StatusClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\StatusClient\\StatusClientServiceProvider"
            ],
            "aliases": {
                "Status": "Cbox\\StatusClient\\Facades\\Status"
            }
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "sbom-check": [
            "@sbom",
            "git diff --exit-code sbom.json"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev",
            "@sbom-check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
